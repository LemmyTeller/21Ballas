# Copier ce fichier en .env.local et renseigner la config web du projet Firebase
# (console Firebase > Paramètres du projet > Vos applications > Config).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true = le front se branche sur les émulateurs locaux (Auth 9099, Firestore 8080)
VITE_USE_EMULATORS=false
