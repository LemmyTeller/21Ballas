rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Rôles : lus dans users/{uid}, jamais fournis par le client ----

    function signedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Doit rester aligné sur RANGS dans src/lib/roles.ts.
    // 'admin' n'est plus un grade attribuable : il ne subsiste que sur les fiches pas encore migrées.
    function rank(role) {
      return {
        'revoque': -1,
        'pending': 0,
        'membre': 1,
        'officier': 2,
        'n2': 3,
        'n1': 4,
        'admin': 5
      }[role];
    }

    // ---- Droit d'administration : séparé du grade, et invisible ----
    // Il vit dans la zone privée users/{uid}/prive/droits ({ admin: true }), que seuls le joueur et les admins
    // peuvent lire. Le grade affiché (role) reste le grade RP : un admin peut être un simple Masque noir.

    function droitAdmin(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)/prive/droits)
        && get(/databases/$(database)/documents/users/$(uid)/prive/droits).data.admin == true;
    }

    // Admin : compte validé qui porte le droit privé, ou fiche encore à l'ancien grade 'admin'
    function isAdmin() {
      return hasProfile()
        && (myRole() == 'admin' || (rank(myRole()) >= 1 && droitAdmin(request.auth.uid)));
    }

    // La fiche visée est-elle celle d'un admin ? (`role` : son grade actuel)
    function cibleAdmin(uid, role) {
      return role == 'admin' || droitAdmin(uid);
    }

    // Un admin a le rang le plus haut, quel que soit son grade affiché
    function myRank() {
      return isAdmin() ? 5 : rank(myRole());
    }

    // Compte validé (ni pending, ni revoque)
    function isValide() {
      return hasProfile() && myRank() >= 1;
    }

    // Masque violet et au-dessus
    function isOfficier() {
      return hasProfile() && myRank() >= 2;
    }

    // N2, N1, admin : ceux qui gèrent les membres
    function isGrade() {
      return hasProfile() && myRank() >= 3;
    }

    function shortString(value, max) {
      return value is string && value.size() <= max;
    }

    // Anniversaire RP : vide ou JJ/MM
    function anniversaireValide(data) {
      return !('anniversaireRP' in data)
        || (data.anniversaireRP is string
            && data.anniversaireRP.matches('^((0[1-9]|[12][0-9]|3[01])/(0[1-9]|1[0-2]))?$'));
    }

    function soldeValide(data) {
      return !('compteBancaire' in data)
        || (data.compteBancaire is number && data.compteBancaire >= 0 && data.compteBancaire <= 1000000000000);
    }

    function vehiculeValide(data) {
      return data.keys().hasOnly(
               ['modele', 'spawn', 'plaque', 'proprietaireUid', 'lieuId', 'note', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['modele', 'plaque', 'proprietaireUid', 'lieuId', 'note', 'createdAt', 'updatedAt'])
        && shortString(data.modele, 60)
        && data.modele.size() > 0
        // Lien au catalogue des véhicules (photo) : facultatif, absent sur les véhicules saisis avant
        && (!('spawn' in data) || data.spawn == null || shortString(data.spawn, 40))
        && shortString(data.plaque, 12)
        && data.proprietaireUid is string
        && (data.lieuId == null || data.lieuId is string)
        && shortString(data.note, 200)
        && data.updatedAt == request.time;
    }

    function lieuValide(data) {
      return data.keys().hasOnly(['nom', 'capacite', 'createdAt'])
        && data.keys().hasAll(['nom', 'capacite', 'createdAt'])
        && shortString(data.nom, 60)
        && data.nom.size() > 0
        && data.capacite is int
        && data.capacite >= 0
        && data.capacite <= 200;
    }

    function tacheValide(data) {
      return data.keys().hasOnly(['titre', 'ordre', 'fait', 'auteurUid', 'createdAt'])
        && data.keys().hasAll(['titre', 'ordre', 'fait', 'auteurUid', 'createdAt'])
        && shortString(data.titre, 200)
        && data.titre.size() > 0
        && data.ordre is number
        && data.fait is bool
        && data.auteurUid is string;
    }

    function categorieValide(data) {
      return data.keys().hasOnly(['nom', 'createdAt'])
        && data.keys().hasAll(['nom', 'createdAt'])
        && shortString(data.nom, 40)
        && data.nom.size() > 0;
    }

    function articleValide(data) {
      return data.keys().hasOnly(['categorieId', 'quantites', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['categorieId', 'quantites', 'createdAt', 'updatedAt'])
        && data.categorieId is string
        && data.quantites is map
        && data.updatedAt == request.time;
    }

    function partenaireValide(data) {
      return data.keys().hasOnly(['nom', 'type', 'telephone', 'note', 'couleur', 'createdAt'])
        && data.keys().hasAll(['nom', 'type', 'telephone', 'note', 'createdAt'])
        && shortString(data.nom, 60)
        && data.nom.size() > 0
        && data.type in ['cartel', 'groupe', 'pm', 'entreprise']
        // Couleur de la tuile, facultative : #rrggbb
        && (!('couleur' in data) || (data.couleur is string && data.couleur.matches('^#[0-9a-fA-F]{6}$')))
        && shortString(data.telephone, 20)
        && shortString(data.note, 300);
    }

    // Nombre facultatif compris entre deux bornes
    function nombreOuNul(valeur, min, max) {
      return valeur == null || (valeur is number && valeur >= min && valeur <= max);
    }

    function commerceValide(data) {
      return data.keys().hasOnly(
               ['zip', 'nom', 'description', 'proprietaireId', 'securise', 'genre', 'taux', 'dureeMinutes',
                'montantMax', 'note', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(
               ['zip', 'nom', 'description', 'proprietaireId', 'securise', 'taux', 'dureeMinutes', 'note',
                'createdAt', 'updatedAt'])
        && shortString(data.zip, 10)
        && data.zip.size() > 0
        && shortString(data.nom, 60)
        && shortString(data.description, 300)
        && (data.proprietaireId == null || data.proprietaireId is string)
        && data.securise is bool
        // Genre du commerce : facultatif, absent sur les fiches créées avant (alors déduit de `securise`)
        && (!('genre' in data) || data.genre in ['standard', 'securise', 'express'])
        && nombreOuNul(data.taux, 0, 100)
        && nombreOuNul(data.dureeMinutes, 0, 100000)
        // Montant maximal blanchissable en une fois : facultatif, absent sur les fiches créées avant
        && (!('montantMax' in data) || nombreOuNul(data.montantMax, 0, 1000000000000))
        && shortString(data.note, 300)
        && data.updatedAt == request.time;
    }

    function contratValide(data) {
      return data.keys().hasOnly(['libelle', 'montant', 'echeance', 'heureFixee', 'hebdo', 'paye', 'note', 'createdAt'])
        && data.keys().hasAll(['libelle', 'montant', 'echeance', 'heureFixee', 'paye', 'note', 'createdAt'])
        && shortString(data.libelle, 80)
        && data.libelle.size() > 0
        && data.montant is number
        && data.montant >= 0
        && data.echeance is timestamp
        && data.heureFixee is bool
        // Contrat hebdomadaire : facultatif, absent sur les contrats ponctuels créés avant
        && (!('hebdo' in data) || data.hebdo is bool)
        && data.paye is bool
        && shortString(data.note, 300);
    }

    function contactValide(data) {
      return data.keys().hasOnly(['nom', 'telephone', 'role', 'partenaireId', 'informations', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['nom', 'telephone', 'role', 'partenaireId', 'informations', 'createdAt', 'updatedAt'])
        && shortString(data.nom, 60)
        && data.nom.size() > 0
        && shortString(data.telephone, 20)
        && shortString(data.role, 60)
        && (data.partenaireId == null || data.partenaireId is string)
        && shortString(data.informations, 1000)
        && data.updatedAt == request.time;
    }

    // Prix facultatif : absent (null) ou nombre positif
    function prixOuNul(valeur) {
      return valeur == null || (valeur is number && valeur >= 0);
    }

    function lignesValides(lignes) {
      return lignes is list && lignes.size() >= 1 && lignes.size() <= 50;
    }

    // Items échangés lors du règlement d'une commande
    function itemsValides(items) {
      return items is list && items.size() <= 30;
    }

    function tarifValide(data) {
      return data.keys().hasOnly(
               ['partenaireId', 'reference', 'sens', 'prixPropre', 'prixSale', 'note', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(
               ['partenaireId', 'reference', 'sens', 'prixPropre', 'prixSale', 'note', 'createdAt', 'updatedAt'])
        && data.partenaireId is string
        && shortString(data.reference, 30)
        && data.reference.size() > 0
        && data.sens in ['achat', 'vente']
        && prixOuNul(data.prixPropre)
        && prixOuNul(data.prixSale)
        && shortString(data.note, 200)
        && data.updatedAt == request.time;
    }

    // ---- Membres : fiche publique, uniquement des informations RP ----

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isValide());
      allow list: if isValide();

      // Première connexion : chacun crée sa propre fiche, forcément en attente
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nomRP', 'telephoneRP', 'role', 'createdAt'])
        && request.resource.data.keys().hasAll(['nomRP', 'telephoneRP', 'role', 'createdAt'])
        && request.resource.data.role == 'pending'
        && shortString(request.resource.data.nomRP, 60)
        && shortString(request.resource.data.telephoneRP, 20)
        && request.resource.data.createdAt == request.time;

      allow update: if
        // Soi-même : profil RP et présence, jamais le rôle.
        // email / displayName / photoURL : anciennes clés, autorisées uniquement en suppression.
        (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
               ['nomRP', 'telephoneRP', 'anniversaireRP', 'compteBancaire', 'present', 'presenceAt',
                'email', 'displayName', 'photoURL'])
          && !request.resource.data.keys().hasAny(['email', 'displayName', 'photoURL'])
          && shortString(request.resource.data.nomRP, 60)
          && shortString(request.resource.data.telephoneRP, 20)
          && anniversaireValide(request.resource.data)
          && soldeValide(request.resource.data)
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['present', 'presenceAt'])
            || (request.resource.data.present is bool && request.resource.data.presenceAt == request.time)
          )
        )
        // Gradé : uniquement le rôle des autres (jamais le sien).
        // Hors admin, la cible et le grade attribué doivent être strictement sous son propre rang,
        // et la cible ne doit pas être un admin, même affiché avec un petit grade.
        || (
          isGrade()
          && request.auth.uid != uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
               ['role', 'validatedBy', 'validatedAt', 'raisonRevocation'])
          && request.resource.data.role in ['membre', 'officier', 'n2', 'n1', 'revoque']
          && (
            isAdmin()
            || (
              !cibleAdmin(uid, resource.data.role)
              && rank(resource.data.role) < myRank()
              && rank(request.resource.data.role) < myRank()
            )
          )
          // Une révocation porte toujours sa raison ; un compte actif n'en garde aucune
          && (
            request.resource.data.role == 'revoque'
              ? request.resource.data.raisonRevocation in ['cavale', 'absence', 'refus']
              : !('raisonRevocation' in request.resource.data)
          )
          && request.resource.data.validatedBy == request.auth.uid
          && request.resource.data.validatedAt == request.time
        )
        // Grade supérieur : correction du solde d'un joueur de rang strictement inférieur (admin : tous)
        || (
          isGrade()
          && request.auth.uid != uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['compteBancaire'])
          && (isAdmin() || (!cibleAdmin(uid, resource.data.role) && rank(resource.data.role) < myRank()))
          && soldeValide(request.resource.data)
        )
        // Admin : son propre grade, qui n'est plus qu'un affichage RP. Le droit admin doit exister une fois
        // l'écriture faite : c'est aussi ce qui permet à une fiche encore au grade 'admin' de migrer, en créant
        // son droit privé dans la même écriture groupée.
        || (
          isAdmin()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'validatedBy', 'validatedAt'])
          && request.resource.data.role in ['membre', 'officier', 'n2', 'n1']
          && request.resource.data.validatedBy == request.auth.uid
          && request.resource.data.validatedAt == request.time
          && existsAfter(/databases/$(database)/documents/users/$(uid)/prive/droits)
          && getAfter(/databases/$(database)/documents/users/$(uid)/prive/droits).data.admin == true
        );

      // Suppression définitive (mort, départ de l'île) : mêmes droits que la révocation
      allow delete: if isGrade()
        && request.auth.uid != uid
        && (isAdmin() || (!cibleAdmin(uid, resource.data.role) && rank(resource.data.role) < myRank()));

      // Zone privée : lisible par le joueur lui-même et par les admins uniquement
      match /prive/{docId} {
        allow get: if signedIn() && (request.auth.uid == uid || isAdmin());

        // Effacée en même temps que la fiche, par celui qui a le droit de supprimer le joueur.
        // Un admin retire aussi par là le droit admin d'un autre.
        allow delete: if isGrade()
          && request.auth.uid != uid
          && (
            isAdmin()
            || (
              !cibleAdmin(uid, get(/databases/$(database)/documents/users/$(uid)).data.role)
              && rank(get(/databases/$(database)/documents/users/$(uid)).data.role) < myRank()
            )
          );

        // compte : l'email du compte, écrit par le joueur lui-même
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && docId == 'compte'
          && request.resource.data.keys().hasOnly(['email'])
          && request.resource.data.email == request.auth.token.email;

        // droits : le droit d'administration. Donné ou retiré par un admin à un autre que lui ;
        // ou créé pour soi-même par une fiche encore à l'ancien grade 'admin' (migration).
        allow create, update: if signedIn()
          && docId == 'droits'
          && request.resource.data.keys().hasOnly(['admin'])
          && request.resource.data.admin is bool
          && (
            (isAdmin() && request.auth.uid != uid)
            || (request.auth.uid == uid && hasProfile() && myRole() == 'admin' && request.resource.data.admin == true)
          );
      }
    }

    // ---- Gestion : véhicules et lieux (garages) ----

    match /vehicules/{id} {
      allow read: if isValide();

      // Chacun ajoute ses propres véhicules ; seul l'admin en ajoute à quelqu'un d'autre
      allow create: if isValide()
        && vehiculeValide(request.resource.data)
        && request.resource.data.createdAt == request.time
        && (request.resource.data.proprietaireUid == request.auth.uid || isAdmin());

      // Le propriétaire ne change que par l'admin
      allow update: if isValide()
        && vehiculeValide(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          isAdmin()
          || (resource.data.proprietaireUid == request.auth.uid
              && request.resource.data.proprietaireUid == request.auth.uid)
        );

      // N1 et N2 : uniquement pour vider le garage d'un joueur de rang inférieur qu'ils suppriment
      allow delete: if isAdmin()
        || (isValide() && resource.data.proprietaireUid == request.auth.uid)
        || (isGrade()
            && rank(get(/databases/$(database)/documents/users/$(resource.data.proprietaireUid)).data.role) < myRank());
    }

    // La capacité est contrôlée par l'appli : les règles ne savent pas compter les véhicules d'un lieu
    match /lieux/{id} {
      allow read: if isValide();
      allow create: if isGrade() && lieuValide(request.resource.data) && request.resource.data.createdAt == request.time;
      allow update: if isGrade()
        && lieuValide(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isGrade();
    }

    // ---- Stock : catégories, articles (quantités par lieu) et prix ----

    match /categoriesStock/{id} {
      allow read: if isValide();
      allow create: if isGrade()
        && categorieValide(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isGrade()
        && categorieValide(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isGrade();
    }

    // Identifiant = id de l'item du catalogue : un seul article par item
    match /articles/{id} {
      allow read: if isValide();
      // Tout membre validé fait entrer du butin (saisie journalière) : il peut modifier les quantités,
      // et créer un article encore non classé. La catégorie et la suppression restent aux gradés.
      allow create: if isValide()
        && articleValide(request.resource.data)
        && request.resource.data.createdAt == request.time
        && (isGrade() || request.resource.data.categorieId == '');
      allow update: if isValide()
        && articleValide(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && (isGrade() || request.resource.data.categorieId == resource.data.categorieId);
      allow delete: if isGrade();
    }

    // ---- Saisie journalière : butin entré dans la journée, un document par jour (AAAA-MM-JJ) ----
    // Le document du jour sert d'affichage ; ceux des jours passés forment l'historique.

    match /saisies/{jour} {
      allow read: if isValide();
      allow create, update: if isValide()
        && jour.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['quantites', 'updatedAt'])
        && request.resource.data.keys().hasAll(['quantites', 'updatedAt'])
        && request.resource.data.quantites is map
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // ---- Blanchiment : commerces recensés en ville, et dépôts d'argent sale dans les nôtres ----

    match /commerces/{id} {
      allow read: if isValide();
      allow create: if isGrade()
        && commerceValide(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isGrade()
        && commerceValide(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isGrade();
    }

    // Un dépôt est lancé, puis récupéré une fois le temps écoulé. Récupéré, il ne change plus (historique).
    // Tant qu'il est en cours, un gradé peut l'annuler, ce qui le supprime.
    match /blanchiments/{id} {
      allow read: if isValide();

      allow create: if isGrade()
        && request.resource.data.keys().hasOnly(
             ['commerceId', 'commerceNom', 'montant', 'taux', 'dureeMinutes', 'debut', 'fin', 'lieuId',
              'statut', 'lanceParUid', 'createdAt'])
        && request.resource.data.keys().hasAll(
             ['commerceId', 'commerceNom', 'montant', 'taux', 'dureeMinutes', 'debut', 'fin', 'lieuId',
              'statut', 'lanceParUid', 'createdAt'])
        && request.resource.data.commerceId is string
        && shortString(request.resource.data.commerceNom, 80)
        && request.resource.data.montant is number
        && request.resource.data.montant > 0
        && request.resource.data.taux is number
        && request.resource.data.taux >= 0
        && request.resource.data.taux <= 100
        && request.resource.data.dureeMinutes is number
        && request.resource.data.dureeMinutes >= 0
        && request.resource.data.debut is timestamp
        && request.resource.data.fin is timestamp
        && (request.resource.data.lieuId == null || request.resource.data.lieuId is string)
        && request.resource.data.statut == 'en_cours'
        && request.resource.data.lanceParUid == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow update: if isGrade()
        && resource.data.statut == 'en_cours'
        && request.resource.data.statut == 'recupere'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ['statut', 'montantRecupere', 'recupereParUid', 'recupereAt'])
        && request.resource.data.montantRecupere is number
        && request.resource.data.montantRecupere >= 0
        && request.resource.data.recupereParUid == request.auth.uid
        && request.resource.data.recupereAt == request.time;

      allow delete: if isGrade() && resource.data.statut == 'en_cours';
    }

    // ---- Carjacking : voitures à aller voler ----
    // Un gradé ajoute la voiture ; tout membre validé la marque volée puis déposée, en son nom ;
    // un gradé clôt la fiche en renseignant le rachat. Une fiche close ne change plus (historique).

    match /carjackings/{id} {
      allow read: if isValide();

      allow create: if isGrade()
        && request.resource.data.keys().hasOnly(
             ['spawn', 'modele', 'note', 'partenaireId', 'statut', 'creeParUid', 'createdAt'])
        && request.resource.data.keys().hasAll(['spawn', 'modele', 'note', 'statut', 'creeParUid', 'createdAt'])
        // Groupe pour lequel la voiture est volée ; absent ou null : pour personne en particulier
        && (!('partenaireId' in request.resource.data)
            || request.resource.data.partenaireId == null
            || request.resource.data.partenaireId is string)
        && (request.resource.data.spawn == null || shortString(request.resource.data.spawn, 40))
        && shortString(request.resource.data.modele, 60)
        && request.resource.data.modele.size() > 0
        && shortString(request.resource.data.note, 200)
        && request.resource.data.statut == 'a_voler'
        && request.resource.data.creeParUid == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow update: if
        // Volée, par tout membre validé
        (
          isValide()
          && resource.data.statut == 'a_voler'
          && request.resource.data.statut == 'vole'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut', 'voleParUid', 'voleAt'])
          && request.resource.data.voleParUid == request.auth.uid
          && request.resource.data.voleAt == request.time
        )
        // Déposée, par tout membre validé
        || (
          isValide()
          && resource.data.statut == 'vole'
          && request.resource.data.statut == 'depose'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut', 'deposeParUid', 'deposeAt'])
          && request.resource.data.deposeParUid == request.auth.uid
          && request.resource.data.deposeAt == request.time
        )
        // Rachat renseigné, par un gradé : la fiche est close
        || (
          isGrade()
          && resource.data.statut == 'depose'
          && request.resource.data.statut == 'clos'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
               ['statut', 'rachete', 'montant', 'lieuId', 'closParUid', 'closAt'])
          && request.resource.data.rachete is bool
          && prixOuNul(request.resource.data.montant)
          && (request.resource.data.lieuId == null || request.resource.data.lieuId is string)
          && request.resource.data.closParUid == request.auth.uid
          && request.resource.data.closAt == request.time
        )
        // Retour à l'étape précédente, par un gradé, pour corriger une erreur
        || (
          isGrade()
          && (
            (
              resource.data.statut == 'vole'
              && request.resource.data.statut == 'a_voler'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut', 'voleParUid', 'voleAt'])
            )
            || (
              resource.data.statut == 'depose'
              && request.resource.data.statut == 'vole'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut', 'deposeParUid', 'deposeAt'])
            )
          )
        );

      allow delete: if isGrade() && resource.data.statut != 'clos';
    }

    // ---- Contrats : sommes que le groupe doit payer, avec une échéance ----

    match /contrats/{id} {
      allow read: if isValide();
      allow create: if isGrade()
        && contratValide(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isGrade()
        && contratValide(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isGrade();
    }

    // Anciens prix du Stock, remplacés par les tarifs : plus aucune écriture, seulement le nettoyage par les gradés
    match /prixArticles/{id} {
      allow read, delete: if isGrade();
    }

    // ---- Tarifs : partenaires (groupes, petites mains) et leurs grilles d'achat / de vente ----

    match /partenaires/{id} {
      allow read: if isValide();
      allow create: if isGrade()
        && partenaireValide(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isGrade()
        && partenaireValide(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isGrade();
    }

    // ---- Annuaire : contacts RP, rattachés ou non à un partenaire ----

    match /contacts/{id} {
      allow read: if isValide();
      allow create: if isGrade()
        && contactValide(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isGrade()
        && contactValide(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isGrade();
    }

    // Une ligne par partenaire, sens et item : ces trois champs ne changent plus après la création
    match /tarifs/{id} {
      allow read: if isValide();
      allow create: if isGrade()
        && tarifValide(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isGrade()
        && tarifValide(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.partenaireId == resource.data.partenaireId
        && request.resource.data.reference == resource.data.reference
        && request.resource.data.sens == resource.data.sens;
      allow delete: if isGrade();
    }

    // ---- Commerce : commandes avec un partenaire, pouvant mêler ventes et achats ----
    // Tout membre validé crée une commande et en modifie les lignes tant qu'elle est en attente.
    // Seul un gradé la clôt (validation ou annulation) ; une commande close ne change plus et rien ne se supprime.

    match /commandes/{id} {
      allow read: if isValide();

      allow create: if isValide()
        && request.resource.data.keys().hasOnly(
             ['partenaireId', 'partenaireNom', 'sens', 'statut', 'lignes', 'creeParUid', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(
             ['partenaireId', 'partenaireNom', 'sens', 'statut', 'lignes', 'creeParUid', 'createdAt', 'updatedAt'])
        && request.resource.data.partenaireId is string
        && shortString(request.resource.data.partenaireNom, 60)
        && request.resource.data.sens in ['achat', 'vente']
        && request.resource.data.statut == 'en_attente'
        && lignesValides(request.resource.data.lignes)
        && request.resource.data.creeParUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if resource.data.statut == 'en_attente'
        && request.resource.data.updatedAt == request.time
        && (
          (
            isValide()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lignes', 'updatedAt'])
            && lignesValides(request.resource.data.lignes)
          )
          || (
            isGrade()
            && request.resource.data.statut in ['validee', 'annulee']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                 ['statut', 'recuPropre', 'recuSale', 'recuItems', 'payePropre', 'payeSale', 'payeItems',
                  'lieuId', 'note', 'clotureParUid', 'clotureAt', 'updatedAt'])
            && prixOuNul(request.resource.data.recuPropre)
            && prixOuNul(request.resource.data.recuSale)
            && itemsValides(request.resource.data.recuItems)
            && prixOuNul(request.resource.data.payePropre)
            && prixOuNul(request.resource.data.payeSale)
            && itemsValides(request.resource.data.payeItems)
            && (request.resource.data.lieuId == null || request.resource.data.lieuId is string)
            && shortString(request.resource.data.note, 300)
            && request.resource.data.clotureParUid == request.auth.uid
            && request.resource.data.clotureAt == request.time
          )
        );

      allow delete: if false;
    }

    // ---- Tâches du groupe : lues et cochées par tous, gérées par les gradés ----

    match /taches/{id} {
      allow read: if isValide();
      allow create: if isGrade()
        && tacheValide(request.resource.data)
        && request.resource.data.auteurUid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if
        (
          isGrade()
          && tacheValide(request.resource.data)
          && request.resource.data.auteurUid == resource.data.auteurUid
          && request.resource.data.createdAt == resource.data.createdAt
        )
        // Tout membre validé peut cocher ou décocher une tâche, sans rien changer d'autre
        || (
          isValide()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fait'])
          && request.resource.data.fait is bool
        );
      allow delete: if isGrade();
    }

    // ---- Annonces ----

    match /annonces/{id} {
      allow read: if isValide();

      allow create: if isOfficier()
        && request.resource.data.keys().hasOnly(['titre', 'contenu', 'auteurUid', 'auteurNom', 'createdAt'])
        && request.resource.data.keys().hasAll(['titre', 'contenu', 'auteurUid', 'auteurNom', 'createdAt'])
        && request.resource.data.auteurUid == request.auth.uid
        && shortString(request.resource.data.titre, 120)
        && request.resource.data.titre.size() > 0
        && shortString(request.resource.data.contenu, 4000)
        && shortString(request.resource.data.auteurNom, 100)
        && request.resource.data.createdAt == request.time;

      allow update: if false;

      allow delete: if isGrade()
        || (isOfficier() && resource.data.auteurUid == request.auth.uid);
    }

    // ---- Journal d'audit : ajout seul ----

    match /logs/{id} {
      allow read: if isGrade();

      allow create: if isGrade()
        && request.resource.data.keys().hasOnly(
             ['action', 'acteurUid', 'acteurNom', 'cibleUid', 'cibleNom', 'ancienRole', 'nouveauRole', 'raison',
              'createdAt'])
        && request.resource.data.acteurUid == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    // Tout le reste est refusé par défaut.
  }
}
